<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1100" prefHeight="760" stylesheets="@estilos.css"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="HotelController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="cabecera">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="HOTELAPP" styleClass="marca"/>
                <Label fx:id="lblHotel" text="Cargando hotel..." styleClass="titulo"/>
            </VBox>
            <Label text="GESTIÓN DE HABITACIONES" styleClass="insignia"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Inicio">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="18">
                            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
                            <VBox spacing="6">
                                <Label text="Habitaciones destacadas" styleClass="seccion"/>
                                <Label text="Una selección de habitaciones del Hotel Sol." styleClass="secundario"/>
                            </VBox>
                            <FlowPane fx:id="contenedorInicio" hgap="16" vgap="16"/>
                            <Label text="Las tarjetas de esta pantalla utilizan el mismo componente que el listado de reservas."
                                   styleClass="nota" wrapText="true"/>
                        </VBox>
                    </ScrollPane>
                </Tab>
                <Tab text="Reservas">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="18">
                            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
                            <VBox spacing="6">
                                <Label text="Listado de habitaciones" styleClass="seccion"/>
                                <Label text="La misma tarjeta reutilizada con los datos de cada habitación." styleClass="secundario"/>
                            </VBox>
                            <FlowPane fx:id="contenedorReservas" hgap="14" vgap="14"/>
                            <Separator/>
                            <Label text="Consulta detallada" styleClass="subtitulo"/>
                            <HBox spacing="24">
                                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="panel">
                                    <Label text="Todas las habitaciones" styleClass="subtitulo"/>
                                    <TableView fx:id="tablaHabitaciones" prefHeight="300" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colNumero" text="N.º" prefWidth="65"/>
                                            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="115"/>
                                            <TableColumn fx:id="colCapacidad" text="Personas" prefWidth="80"/>
                                            <TableColumn fx:id="colPrecio" text="€/noche" prefWidth="85"/>
                                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                                        </columns>
                                    </TableView>
                                    <Label text="Disponibilidad indicada en el registro del hotel" styleClass="nota"/>
                                </VBox>
                                <VBox spacing="12" prefWidth="280" minWidth="260" styleClass="panel">
                                    <Label text="Buscar habitación" styleClass="subtitulo"/>
                                    <TextField fx:id="txtNumero" promptText="Ej. 101" onAction="#buscarHabitacion"/>
                                    <Button text="Buscar habitación" onAction="#buscarHabitacion"
                                            defaultButton="true" maxWidth="Infinity" styleClass="principal"/>
                                    <Label text="RESULTADO" styleClass="nota"/>
                                    <Label fx:id="lblResultado"
                                           text="Pulsa Ver detalles o busca una habitación por su número."
                                           wrapText="true" maxWidth="Infinity" styleClass="resultado"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </Tab>
            </tabs>
        </TabPane>
    </center>
    <bottom>
        <Label text="Hotel Sol · Consulta de disponibilidad" styleClass="pie" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
